// DuitKu - Prisma Schema
// PostgreSQL (Vercel Postgres / Neon)

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// NextAuth.js (Auth.js) Models
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // Untuk autentikasi email & password (bcrypt hash)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  // Relasi Model Bisnis
  akun         Akun[]
  kategori     Kategori[]
  transaksi    Transaksi[]
  utang        Utang[]
  uangTitipan  UangTitipan[]
  rekonsiliasi Rekonsiliasi[]
  chatSessions ChatSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// Model Bisnis DuitKu
// ==========================================

enum TipeAkun {
  TUNAI
  BANK
  EWALLET
  EMONEY
}

enum TipeTransaksi {
  PEMASUKAN
  PENGELUARAN
  TRANSFER
}

enum MetodePembayaran {
  TUNAI
  TRANSFER_BANK
  QRIS
  KARTU_DEBIT
  KARTU_KREDIT
  EWALLET
  LAINNYA
}

enum TipeUtang {
  UTANG
  PIUTANG
}

enum StatusUtang {
  BELUM_LUNAS
  DIBAYAR_SEBAGIAN
  LUNAS
}

enum StatusTitipan {
  AKTIF
  DIKEMBALIKAN
}

model Akun {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String   @default("cash")
  initialBalance Decimal  @default(0) @db.Decimal(15, 2)
  currentBalance Decimal  @default(0) @db.Decimal(15, 2)
  currency       String   @default("IDR")
  icon           String?
  color          String?
  isEntrusted    Boolean  @default(false)
  owner          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transaksi       Transaksi[]       @relation("AkunTransaksiAsal")
  transaksiTujuan Transaksi[]       @relation("AkunTransaksiTujuan")
  rekonsiliasi    Rekonsiliasi[]
  pembayaranUtang PembayaranUtang[]

  @@index([userId])
}

model Kategori {
  id        String        @id @default(cuid())
  userId    String? // null jika kategori default sistem
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String        @default("expense")
  icon      String?
  color     String?
  parentId  String?
  parent    Kategori?     @relation("KategoriHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Kategori[]    @relation("KategoriHierarchy")
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  transaksi Transaksi[]

  @@unique([userId, type, name])
  @@index([userId])
}

model Transaksi {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String
  akun             Akun             @relation("AkunTransaksiAsal", fields: [accountId], references: [id], onDelete: Cascade)
  transferToId     String?
  akunTujuan       Akun?            @relation("AkunTransaksiTujuan", fields: [transferToId], references: [id], onDelete: SetNull)
  categoryId       String?
  kategori         Kategori?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount           Decimal          @db.Decimal(15, 2)
  type             String           @default("expense")
  paymentMethod    String?          @default("cash")
  date             DateTime         @default(now())
  note             String?
  tags             String[]         @default([])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  reconciliation   Rekonsiliasi?    @relation("RekonsiliasiAdjustment")

  @@index([userId])
  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
}

model Utang {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  namaPihak      String
  jumlah         Decimal     @db.Decimal(15, 2)
  jumlahTerbayar Decimal     @default(0) @db.Decimal(15, 2)
  tipe           TipeUtang
  jatuhTempo     DateTime?
  status         StatusUtang @default(BELUM_LUNAS)
  catatan        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  pembayaran PembayaranUtang[]

  @@index([userId])
  @@index([status])
}

model PembayaranUtang {
  id        String   @id @default(cuid())
  utangId   String
  utang     Utang    @relation(fields: [utangId], references: [id], onDelete: Cascade)
  akunId    String?
  akun      Akun?    @relation(fields: [akunId], references: [id], onDelete: SetNull)
  nominal   Decimal  @db.Decimal(15, 2)
  tanggal   DateTime @default(now())
  catatan   String?
  createdAt DateTime @default(now())

  @@index([utangId])
  @@index([akunId])
}

model UangTitipan {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner       String
  amount      Decimal   @db.Decimal(15, 2)
  status      String    @default("held")
  borrowedBy  String?
  note        String?
  returnedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, owner])
  @@map("uang_titipan")
}

model Rekonsiliasi {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String
  account        Akun       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date           DateTime   @default(now())
  systemBalance  Decimal    @db.Decimal(15, 2) // saldo sistem sebelum adjustment
  actualBalance  Decimal    @db.Decimal(15, 2) // saldo riil yang diinput user
  difference     Decimal    @db.Decimal(15, 2) // selisih (actual - system)
  reason         String                        // alasan user
  adjustmentTxId String?    @unique            // ID transaksi adjustment (kalau selisih ≠ 0)
  adjustmentTx   Transaksi? @relation("RekonsiliasiAdjustment", fields: [adjustmentTxId], references: [id])
  createdAt      DateTime   @default(now())

  @@index([userId, accountId])
  @@index([userId, date])
  @@map("rekonsiliasi")
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Chat Baru")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user" | "assistant" | "system"
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
